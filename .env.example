# ===================
# ADMIN AUTHENTICATION
# ===================
ADMIN_USER=your_admin_username
ADMIN_PASS=your_secure_password
SESSION_SECRET=random-secret-key-change-me-in-production

# ===================
# DATABASE
# ===================
DATABASE_URL=postgresql://user:password@host:port/database
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_database_name

# ===================
# STREAMING (ICECAST / CUSTOM HUB)
# ===================
# Set ICECAST_URL when the custom hub is running — /api/nowplaying will prefer
# Icecast's /status-json.xsl over the DB fallback automatically.
# e.g. http://your-server:8000
ICECAST_URL=

# ===================
# AZURACAST INTEGRATION (legacy — no longer required)
# ===================
# Main AzuraCast API Configuration
AZURACAST_BASE_URL=http://your-azuracast-server
AZURACAST_API_KEY=your_azuracast_api_key
AZURACAST_STATION_ID=1
AZURACAST_STATION_SLUG=your_station_slug
AZURACAST_STATION=your_station_name

# AzuraCast Stream URL
AZ_STREAM_URL=http://your-azuracast-server/radio/8000/radio.mp3

# SFTP Configuration (for file uploads to AzuraCast)
AZ_SFTP_HOST=your-azuracast-server
AZ_SFTP_PORT=2022
AZ_SFTP_USER=your_sftp_username
AZ_SFTP_PASS=your_sftp_password

# Legacy SFTP variables (kept for backward compatibility)
SFTP_HOST=your-azuracast-server
SFTP_PORT=2022
SFTP_USER=your_sftp_username
SFTP_PASS=your_sftp_password

# ===================
# EXTERNAL APIS
# ===================
# Last.fm API (for music metadata)
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_SHARED_SECRET=your_lastfm_shared_secret

# Spotify API (for music metadata)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Sheets Integration (for resident applications)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key

# ===================
# OBJECT STORAGE
# ===================
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your_bucket_id
PUBLIC_OBJECT_SEARCH_PATHS=path1,path2
PRIVATE_OBJECT_DIR=/private/storage/path

# ===================
# REPLIT SPECIFIC (Auto-populated)
# ===================
# These are automatically set by Replit
# REPLIT_DOMAINS=
# REPLIT_DEV_DOMAIN=
# REPL_ID=
# NODE_ENV=development

# ===================
# NOTES
# ===================
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env to version control
# 3. For production, use environment-specific secrets management
# 4. All sensitive values should be kept as secrets in Replit
